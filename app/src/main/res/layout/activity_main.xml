<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/app_name"
        android:textColor="@color/primary_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    </LinearLayout>

    <include android:id="@+id/order_summary_overlay" layout="@layout/view_order_summary" android:visibility="gone" />
    <include android:id="@+id/checkout_overlay" layout="@layout/view_checkout" android:visibility="gone" />
    <include android:id="@+id/confirmation_overlay" layout="@layout/view_order_confirmation" android:visibility="gone" />
    <include android:id="@+id/orders_overlay" layout="@layout/view_my_orders" android:visibility="gone" />
    <include android:id="@+id/notifications_overlay" layout="@layout/view_notifications" android:visibility="gone" />
    <include android:id="@+id/profile_overlay" layout="@layout/view_profile" android:visibility="gone" />
    <include android:id="@+id/support_overlay" layout="@layout/view_support" android:visibility="gone" />

    <include
        android:id="@+id/artwork_overlay"
        layout="@layout/view_artwork"
        android:visibility="gone" />

    <include
        android:id="@+id/detail_overlay"
        layout="@layout/view_product_detail"
        android:visibility="gone" />

    <include
        android:id="@+id/listing_overlay"
        layout="@layout/view_listing"
        android:visibility="gone" />

    <include
        android:id="@+id/categories_overlay"
        layout="@layout/view_categories"
        android:visibility="gone" />

    <include
        android:id="@+id/home_overlay"
        layout="@layout/view_home"
        android:visibility="gone" />

    <include
        android:id="@+id/login_overlay"
        layout="@layout/view_login"
        android:visibility="gone" />

    <include
        android:id="@+id/register_overlay"
        layout="@layout/view_register"
        android:visibility="gone" />

    <include
        android:id="@+id/splash_overlay"
        layout="@layout/view_splash"
        android:visibility="gone" />
</FrameLayout>
