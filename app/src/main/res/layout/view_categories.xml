<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="116dp">
        <com.printxpress.app.CatalogHeaderView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ImageView
            android:layout_width="140dp"
            android:layout_height="108dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/splash_leaf_detail" />
        <ImageView
            android:id="@+id/categories_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="50dp"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/register_back_icon" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:text="Categories"
            android:textColor="#0A1E2C"
            android:textSize="27sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/categories_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="50dp"
            android:contentDescription="Search products"
            android:padding="12dp"
            android:src="@drawable/home_ic_search" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/categories_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFFFE"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/categories_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
