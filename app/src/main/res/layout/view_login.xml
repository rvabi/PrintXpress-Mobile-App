<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <com.printxpress.app.LoginLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.printxpress.app.LoginBackdropView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/login_top_leaf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_leaf_detail" />

        <ImageView
            android:id="@+id/login_bottom_leaf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.86"
            android:contentDescription="@null"
            android:rotation="-17"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_leaf_detail" />

        <TextView
            android:id="@+id/login_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="PrintXpress"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.19"
            android:singleLine="true"
            android:text="CUSTOM PRINTS FOR EVERY IDEA"
            android:textColor="@color/surface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Welcome Back"
            android:textColor="#101825"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Sign in to your PrintXpress account"
            android:textColor="@color/secondary_text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/login_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/login_field"
            android:drawableStart="@drawable/login_email_icon"
            android:drawablePadding="20dp"
            android:elevation="4dp"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/login_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/login_field"
            android:drawableStart="@drawable/login_lock_icon"
            android:drawablePadding="20dp"
            android:elevation="4dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="17dp"
            android:paddingEnd="55dp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/login_eye"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Show password"
            android:elevation="8dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/login_eye_icon" />

        <TextView
            android:id="@+id/login_forgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Forgot password?"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/login_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/login_button"
            android:drawableEnd="@drawable/login_arrow_icon"
            android:drawablePadding="12dp"
            android:elevation="5dp"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="Sign In"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/login_social_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/border" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:text="or continue with" android:textColor="@color/secondary_text"
                android:textSize="14sp" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/border" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/login_socials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <com.printxpress.app.LoginSocialIconView
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/login_social_tile"
                android:contentDescription="Google sign in unavailable" android:elevation="3dp"
                android:tag="google" />
            <com.printxpress.app.LoginSocialIconView
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="20dp" android:layout_weight="1"
                android:background="@drawable/login_social_tile"
                android:contentDescription="Apple sign in unavailable" android:elevation="3dp"
                android:tag="apple" />
            <com.printxpress.app.LoginSocialIconView
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="20dp" android:layout_weight="1"
                android:background="@drawable/login_social_tile"
                android:contentDescription="Facebook sign in unavailable" android:elevation="3dp"
                android:tag="facebook" />
        </LinearLayout>

        <TextView
            android:id="@+id/login_sign_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Don't have an account? Sign Up"
            android:textColor="@color/secondary_text"
            android:textSize="15sp" />
    </com.printxpress.app.LoginLayout>
</ScrollView>
