<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAFFFE" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical" android:paddingBottom="24dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="91dp">
                <com.printxpress.app.OrderHeaderView android:layout_width="match_parent" android:layout_height="match_parent" />
                <ImageView android:id="@+id/confirmation_back" android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="top|start" android:layout_marginStart="13dp" android:layout_marginTop="43dp"
                    android:contentDescription="Back to orders" android:padding="12dp" android:src="@drawable/register_back_icon" />
            </FrameLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="270dp"
                android:layout_marginStart="22dp" android:layout_marginTop="-7dp" android:layout_marginEnd="22dp"
                android:contentDescription="PrintXpress order confirmed illustration" android:scaleType="fitCenter"
                android:src="@drawable/order_confirmed_illustration" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginTop="4dp" android:layout_marginEnd="20dp"
                android:gravity="center" android:text="Order Confirmed!" android:textColor="#0A1E2C"
                android:textSize="31sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="34dp" android:layout_marginTop="9dp" android:layout_marginEnd="34dp"
                android:gravity="center" android:text="Thank you for your order.\nYour print request is ready for processing."
                android:textColor="@color/secondary_text" android:textSize="16sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="83dp"
                android:layout_marginStart="24dp" android:layout_marginTop="26dp" android:layout_marginEnd="24dp"
                android:background="@drawable/order_selected" android:gravity="center_vertical" android:orientation="vertical"
                android:paddingStart="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Order #"
                    android:textColor="@color/secondary_text" android:textSize="14sp" />
                <TextView android:id="@+id/confirmation_number" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#0A1E2C" android:textSize="24sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/confirmation_track" android:layout_width="match_parent" android:layout_height="58dp"
                android:layout_marginStart="24dp" android:layout_marginTop="24dp" android:layout_marginEnd="24dp"
                android:background="@drawable/login_button" android:gravity="center" android:text="Track Order  →"
                android:textColor="@color/surface" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/confirmation_shop" android:layout_width="match_parent" android:layout_height="58dp"
                android:layout_marginStart="24dp" android:layout_marginTop="12dp" android:layout_marginEnd="24dp"
                android:background="@drawable/order_selected" android:gravity="center" android:text="Continue Shopping"
                android:textColor="#0A1E2C" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <ImageView android:layout_width="match_parent" android:layout_height="104dp"
        android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/order_bottom_wave" />
</LinearLayout>
