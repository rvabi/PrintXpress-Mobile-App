<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFFFE" android:orientation="vertical">
    <ScrollView android:id="@+id/profile_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="285dp">
                <com.printxpress.app.OrderHeaderView android:layout_width="match_parent" android:layout_height="match_parent" />
                <ImageView android:layout_width="112dp" android:layout_height="135dp"
                    android:layout_gravity="top|start" android:layout_marginTop="106dp"
                    android:contentDescription="@null" android:rotationY="180" android:scaleType="centerCrop"
                    android:src="@drawable/splash_leaf_detail" />
                <ImageView android:layout_width="126dp" android:layout_height="155dp"
                    android:layout_gravity="top|end" android:layout_marginTop="57dp"
                    android:contentDescription="@null" android:scaleType="centerCrop"
                    android:src="@drawable/splash_leaf_detail" />
                <ImageView android:id="@+id/profile_back" android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="top|start" android:layout_marginStart="13dp" android:layout_marginTop="49dp"
                    android:contentDescription="Back to home" android:padding="12dp" android:src="@drawable/register_back_icon" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal" android:layout_marginTop="79dp"
                    android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/profile_initials" android:layout_width="93dp" android:layout_height="93dp"
                        android:background="@drawable/profile_avatar_circle" android:elevation="5dp" android:gravity="center"
                        android:textColor="@color/dark_mint" android:textSize="33sp" android:textStyle="bold" />
                    <TextView android:id="@+id/profile_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:gravity="center" android:textColor="#0A1E2C"
                        android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:id="@+id/profile_email" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:gravity="center" android:textColor="@color/secondary_text"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/profile_menu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="5dp"
                android:paddingEnd="18dp" />
            <TextView android:id="@+id/profile_logout" android:layout_width="match_parent" android:layout_height="61dp"
                android:layout_marginStart="33dp" android:layout_marginTop="8dp" android:layout_marginEnd="33dp"
                android:gravity="center" android:text="↪  Log Out" android:textColor="@color/coral"
                android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <ImageView android:layout_width="match_parent" android:layout_height="62dp"
        android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/order_bottom_wave" />
</LinearLayout>
