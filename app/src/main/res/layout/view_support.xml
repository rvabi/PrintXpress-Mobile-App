<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAFFFE" android:orientation="vertical">
    <ScrollView android:id="@+id/support_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingBottom="15dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="192dp">
                <com.printxpress.app.OrderHeaderView android:layout_width="match_parent" android:layout_height="match_parent" />
                <ImageView android:layout_width="115dp" android:layout_height="145dp" android:layout_gravity="top|end"
                    android:layout_marginTop="24dp" android:contentDescription="@null" android:scaleType="centerCrop"
                    android:src="@drawable/splash_leaf_detail" />
                <ImageView android:id="@+id/support_back" android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="top|start" android:layout_marginStart="13dp" android:layout_marginTop="49dp"
                    android:contentDescription="Back to profile" android:padding="12dp" android:src="@drawable/register_back_icon" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal" android:layout_marginTop="54dp"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PrintXpress" android:textColor="@color/surface" android:textSize="27sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:letterSpacing="0.2" android:text="CUSTOM PRINTS FOR EVERY IDEA"
                        android:textColor="@color/surface" android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="-18dp" android:gravity="center" android:text="Help &amp; Support"
                android:textColor="#0A1E2C" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center" android:text="How can we help you today?"
                android:textColor="@color/secondary_text" android:textSize="16sp" />
            <EditText android:id="@+id/support_search" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginStart="21dp" android:layout_marginTop="21dp" android:layout_marginEnd="21dp"
                android:background="@drawable/order_outline" android:drawableStart="@drawable/home_ic_search"
                android:drawablePadding="13dp" android:hint="Search for help..." android:inputType="text"
                android:paddingStart="15dp" android:paddingEnd="15dp" android:singleLine="true"
                android:textColor="#0A1E2C" android:textColorHint="@color/secondary_text" android:textSize="16sp" />
            <LinearLayout android:id="@+id/support_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:orientation="vertical" android:paddingStart="18dp"
                android:paddingEnd="18dp" />
        </LinearLayout>
    </ScrollView>
    <ImageView android:layout_width="match_parent" android:layout_height="69dp" android:contentDescription="@null"
        android:scaleType="fitXY" android:src="@drawable/order_bottom_wave" />
</LinearLayout>
