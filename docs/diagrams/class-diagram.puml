@startuml
title PrintXpress - Planned domain class diagram
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Domain models" {
  class User {
    +userId: long
    +fullName: String
    +email: String
    +phone: String
    +password: String
  }
  class Address {
    +addressId: long
    +userId: long
    +addressLine: String
    +city: String
    +district: String
    +postalCode: String
  }
  class Category {
    +categoryId: long
    +categoryName: String
  }
  class Product {
    +productId: long
    +categoryId: long
    +productName: String
    +description: String
    +basePrice: BigDecimal
    +imageName: String
  }
  class ProductOption {
    +optionId: long
    +productId: long
    +optionType: String
    +optionValue: String
    +priceAdjustment: BigDecimal
  }
  class Order {
    +orderId: long
    +userId: long
    +orderDate: String
    +orderType: String
    +deliveryAddress: String
    +scheduledFor: String
    +rescheduledAt: String
    +totalAmount: BigDecimal
    +status: String
  }
  class OrderItem {
    +orderItemId: long
    +orderId: long
    +productId: long
    +quantity: int
    +customText: String
    +artworkPath: String
    +unitPrice: BigDecimal
    +subtotal: BigDecimal
  }
  class OrderItemOption {
    +orderItemOptionId: long
    +orderItemId: long
    +optionId: long
    +priceAdjustment: BigDecimal
  }
  class SavedDesign {
    +designId: long
    +userId: long
    +designName: String
    +filePath: String
  }
  class Notification {
    +notificationId: long
    +userId: long
    +title: String
    +message: String
    +createdAt: String
    +isRead: boolean
  }
  class Promotion {
    +promotionId: long
    +title: String
    +description: String
    +discount: BigDecimal
    +startDate: String
    +endDate: String
  }
}

package "Persistence" {
  class DatabaseHelper {
    +createTables(): void
    +registerUser(user: User): long
    +authenticateUser(email: String, password: String): User
    +getProducts(): List
    +createOrder(order: Order, items: List): long
    +getUserOrders(userId: long): List
    +updateOrderStatus(orderId: long, status: String): boolean
    +cancelOrder(orderId: long): boolean
    +rescheduleOrder(orderId: long, scheduledFor: String): boolean
  }
}

User "1" -- "0..*" Address : owns
User "1" -- "0..*" Order : places
User "1" -- "0..*" SavedDesign : saves
User "1" -- "0..*" Notification : receives
Category "1" -- "0..*" Product : groups
Product "1" -- "0..*" ProductOption : offers
Product "1" -- "0..*" OrderItem : appears in
Order "1" -- "1..*" OrderItem : contains
OrderItem "1" -- "0..*" OrderItemOption : selects
ProductOption "1" -- "0..*" OrderItemOption : chosen as
DatabaseHelper ..> User
DatabaseHelper ..> Product
DatabaseHelper ..> Order

note right of User
password holds a hash, never plain text.
end note
note right of DatabaseHelper
Planned responsibilities include foreign-key setup,
transactional order save, option-product matching,
and Processing-only customer order changes.
end note
@enduml
