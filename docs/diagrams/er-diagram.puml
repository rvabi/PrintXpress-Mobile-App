@startuml
title PrintXpressDB - Entity Relationship Diagram
hide circle
skinparam linetype ortho

entity "users" as users {
  * user_id : INTEGER <<PK>>
  --
  full_name : TEXT
  email : TEXT
  phone : TEXT
  password : TEXT
}
entity "addresses" as addresses {
  * address_id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  address_line : TEXT
  city : TEXT
  district : TEXT
  postal_code : TEXT
}
entity "categories" as categories {
  * category_id : INTEGER <<PK>>
  --
  category_name : TEXT
}
entity "products" as products {
  * product_id : INTEGER <<PK>>
  --
  category_id : INTEGER <<FK>>
  product_name : TEXT
  description : TEXT
  base_price : REAL
  image_name : TEXT
}
entity "product_options" as product_options {
  * option_id : INTEGER <<PK>>
  --
  product_id : INTEGER <<FK>>
  option_type : TEXT
  option_value : TEXT
  price_adjustment : REAL
}
entity "orders" as orders {
  * order_id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  order_date : TEXT
  order_type : TEXT
  delivery_address : TEXT
  scheduled_for : TEXT
  rescheduled_at : TEXT
  total_amount : REAL
  status : TEXT
}
entity "order_items" as order_items {
  * order_item_id : INTEGER <<PK>>
  --
  order_id : INTEGER <<FK>>
  product_id : INTEGER <<FK>>
  quantity : INTEGER
  custom_text : TEXT
  artwork_path : TEXT
  unit_price : REAL
  subtotal : REAL
}
entity "order_item_options" as order_item_options {
  * order_item_option_id : INTEGER <<PK>>
  --
  order_item_id : INTEGER <<FK>>
  option_id : INTEGER <<FK>>
  price_adjustment : REAL
}
entity "saved_designs" as saved_designs {
  * design_id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  design_name : TEXT
  file_path : TEXT
}
entity "notifications" as notifications {
  * notification_id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  title : TEXT
  message : TEXT
  created_at : TEXT
  is_read : INTEGER
}
entity "promotions" as promotions {
  * promotion_id : INTEGER <<PK>>
  --
  title : TEXT
  description : TEXT
  discount : REAL
  start_date : TEXT
  end_date : TEXT
}

users ||--o{ addresses : owns
users ||--o{ orders : places
users ||--o{ saved_designs : saves
users ||--o{ notifications : receives
categories ||--o{ products : groups
products ||--o{ product_options : offers
products ||--o{ order_items : ordered_as
orders ||--|{ order_items : contains
order_items ||--o{ order_item_options : selects
product_options ||--o{ order_item_options : chosen_as

note bottom of promotions
Independent offer records.
end note
@enduml
