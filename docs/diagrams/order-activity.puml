@startuml
title PrintXpress - Place and manage an order

start
:Browse category and product;
:Review product details;
:Select available print options;
:Enter quantity, custom text, and/or choose artwork;
if (Customization valid?) then (yes)
  :Calculate unit price and subtotal;
else (no)
  :Show validation errors;
  stop
endif
:Review order summary;
:Select Pickup or Home Delivery;
if (Home Delivery?) then (yes)
  :Select or enter delivery address;
  if (Address valid?) then (yes)
    :Continue to scheduling;
  else (no)
    :Show address errors;
    stop
  endif
else (pickup)
  :Use pickup location;
endif
:Select scheduled pickup/delivery date and time;
if (Schedule valid?) then (yes)
  :Save order, items, and selected options\nin one SQLite transaction;
  if (Save succeeded?) then (yes)
    :Set status to Processing;
    :Show confirmation and order details;
  else (no)
    :Roll back and show order error;
    stop
  endif
else (no)
  :Show schedule error;
  stop
endif
if (Customer requests cancellation or rescheduling?) then (yes)
  :Reload current order status;
  if (Status is Processing?) then (yes)
    if (Cancel?) then (yes)
      :Set status to Cancelled;
    else (reschedule)
      :Update scheduled_for and rescheduled_at;
    endif
  else (no)
    :Explain that the order can no longer be changed;
  endif
else (no)
  :Keep current order details;
endif
stop
@enduml
