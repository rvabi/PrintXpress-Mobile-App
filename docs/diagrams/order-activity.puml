@startuml
title PrintXpress - Place an order

start
:Browse categories and products;
:Select a product and view details;
repeat
  :Customize product and select required options;
  :Enter custom text and/or select artwork\nwhere applicable;
  :Enter quantity;
  :Validate quantity, required options and content;
  if (Customization invalid?) then (yes)
    :Show errors and allow correction;
  else (no)
    :Mark item ready;
  endif
repeat while (Item not ready?) is (yes) not (no)

:Calculate LKR prices using BigDecimal;
:Review order summary;
repeat
  :Choose Pickup or Home Delivery;
  if (Home Delivery?) then (yes)
    :Select or add delivery address;
  else (pickup)
    :No delivery address required;
  endif
  :Choose scheduled pickup/delivery date and time;
  :Validate address, schedule and complete order;
  if (Checkout invalid?) then (yes)
    :Show errors and allow correction;
  else (no)
    :Mark checkout ready;
  endif
repeat while (Checkout not ready?) is (yes) not (no)

:Verify every selected option belongs\nto its order item's product;
if (Option-product mismatch?) then (yes)
  :Reject order and show error;
  stop
else (no)
  :Begin SQLite transaction;
  :Create Order with status Processing;
  :Create one or more OrderItem rows;
  :Save selected OrderItemOption rows;
  if (All rows saved?) then (yes)
    :Commit transaction;
    :Show order confirmation;
  else (no)
    :Roll back transaction;
    :Show order-save error;
  endif
endif
stop
@enduml
