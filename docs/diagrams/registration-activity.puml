@startuml
title PrintXpress - Customer registration

start
:Open Registration screen;
repeat
  :Enter name, email, phone,\npassword and confirmation;
  :Validate required fields;
  :Validate email format;
  :Validate phone number;
  :Validate password requirements;
  :Check password confirmation;
  if (Any field invalid?) then (yes)
    :Show field-specific errors\nand allow correction;
  else (no)
    :Check whether email already exists;
    if (Email already registered?) then (yes)
      :Show duplicate-email error\nand allow correction;
    else (no)
      :Mark form ready;
    endif
  endif
repeat while (Form not ready?) is (yes) not (no)

:Hash password;
:Save user in SQLite;
if (Save succeeded?) then (yes)
  :Show registration success;
  :Navigate to Login screen;
else (no)
  :Show save failure;
endif
stop
@enduml
